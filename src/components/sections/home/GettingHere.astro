---
/**
 * -20m. Bantayan is awkward to reach, and this is otherwise the most common
 * question. The route is one direct bus that boards the ferry, so this is a
 * single leg rather than a numbered itinerary.
 *
 * Durations, fares and timetables are placeholders until the owner confirms
 * them. None of it is invented here.
 */
import { render } from 'astro:content';
import { requirePage } from '../../../lib/content';
import Stat from '../../primitives/Stat.astro';
import Placeholder from '../../primitives/Placeholder.astro';
import { isPlaceholder } from '../../../lib/placeholders';

const entry = await requirePage('getting-here');
const { Content } = await render(entry);

const legs = entry.data.legs ?? [];
const schedules = entry.data.schedules ?? [];
---

<section class="section journey" id="getting-here" aria-labelledby="journey-heading">
	<div class="container">
		<p class="eyebrow">The journey</p>
		<h2 id="journey-heading">{entry.data.title}</h2>

		{entry.data.intro && <p class="journey__intro prose">{entry.data.intro}</p>}

		{
			legs.map((leg) => (
				<div class="route">
					<p class="route__places">
						<span>{leg.from}</span>
						<span class="route__arrow" aria-hidden="true">
							&rarr;
						</span>
						<span class="visually-hidden">to</span>
						<span>{leg.to}</span>
					</p>

					<p class="route__mode data">{leg.mode}</p>

					<dl class="route__stats">
						<Stat label="Journey time" value={leg.duration} emphasis />
						<Stat label="Fare" value={leg.cost} emphasis />
						{schedules.map((schedule) => (
							<Stat label={schedule.label} value={schedule.value} />
						))}
					</dl>

					{leg.note &&
						(isPlaceholder(leg.note) ? (
							<p class="route__note">
								<Placeholder value={leg.note} />
							</p>
						) : (
							<p class="route__note">{leg.note}</p>
						))}
				</div>
			))
		}

		<div class="prose journey__body">
			<Content />
		</div>
	</div>
</section>

<style>
	.journey {
		padding-inline-start: var(--rail-width);
	}

	.journey__intro {
		margin-block-start: var(--space-sm);
		color: var(--fg-muted);
	}

	.route {
		max-width: 56rem;
		margin-block-start: var(--space-lg);
		padding: var(--space-md);
		background-color: var(--bg-raised);
		border-radius: var(--radius-lg);
	}

	.route__places {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-sm);
		align-items: baseline;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-display-loose);
		line-height: var(--leading-snug);
	}

	.route__arrow {
		color: var(--fg-muted);
	}

	.route__mode {
		margin-block-start: var(--space-3xs);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-caps);
		color: var(--fg-muted);
	}

	.route__stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md) var(--space-xl);
		margin: 0;
		margin-block-start: var(--space-md);
		padding-block-start: var(--space-md);
		border-block-start: 1px solid var(--rule);
	}

	.route__note {
		margin-block-start: var(--space-md);
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.journey__body {
		margin-block-start: var(--space-lg);
	}

	@media (min-width: 768px) {
		.route {
			padding: var(--space-lg);
		}
	}
</style>
