---
/**
 * -40m. This is a one-instructor operation and that personal relationship is
 * the actual product, so this section gets a full-width portrait and room to
 * breathe rather than a byline at the bottom of the page.
 */
import { render } from 'astro:content';
import { requirePage } from '../../../lib/content';
import Photo from '../../primitives/Photo.astro';
import Placeholder from '../../primitives/Placeholder.astro';
import { isPlaceholder } from '../../../lib/placeholders';

const entry = await requirePage('instructor');
const { Content } = await render(entry);

const certifications = entry.data.certifications ?? [];
---

<section class="section instructor" id="instructor" aria-labelledby="instructor-heading">
	<div class="container instructor__inner">
		<div class="instructor__portrait">
			{
				entry.data.image && (
					<Photo
						src={entry.data.image}
						alt={entry.data.imageAlt ?? ''}
						sizes="(min-width: 768px) 38vw, 92vw"
					/>
				)
			}
		</div>

		<div class="instructor__body">
			<p class="eyebrow">The instructor</p>
			<h2 id="instructor-heading">{entry.data.title}</h2>

			{
				entry.data.instructorName && (
					<p class="instructor__name">
						{isPlaceholder(entry.data.instructorName) ? (
							<Placeholder value={entry.data.instructorName} />
						) : (
							entry.data.instructorName
						)}
					</p>
				)
			}

			<div class="prose instructor__prose">
				<Content />
			</div>

			{
				certifications.length > 0 && (
					<div class="instructor__certs">
						<p class="instructor__certs-label">Certifications</p>
						<ul class="instructor__certs-list">
							{certifications.map((cert) => (
								<li>
									{isPlaceholder(cert) ? (
										<Placeholder value={cert} />
									) : (
										<span class="data">{cert}</span>
									)}
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.instructor {
		padding-inline-start: var(--rail-width);
		background-color: var(--bg-sunk);
	}

	.instructor__inner {
		display: grid;
		gap: var(--space-lg);
		align-items: start;
	}

	.instructor__portrait :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.instructor__name {
		margin-block-start: var(--space-sm);
		font-size: var(--text-lg);
		font-weight: var(--weight-medium);
	}

	.instructor__prose {
		margin-block-start: var(--space-md);
		color: var(--fg-muted);
	}

	.instructor__certs {
		margin-block-start: var(--space-lg);
		padding-block-start: var(--space-md);
		border-block-start: 1px solid var(--rule);
	}

	.instructor__certs-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-caps);
		color: var(--fg-muted);
	}

	.instructor__certs-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-md);
		margin: 0;
		margin-block-start: var(--space-2xs);
		padding: 0;
		list-style: none;
	}

	@media (min-width: 768px) {
		.instructor__inner {
			grid-template-columns: 2fr 3fr;
			gap: var(--space-2xl);
		}
	}
</style>
