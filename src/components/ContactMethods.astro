---
/**
 * The full contact trio: WhatsApp first, then the same number as a `tel:`
 * link, then email as a fallback for visitors without WhatsApp.
 *
 * Used at the section-level call to action. Course cards carry the WhatsApp
 * deep link alone, since they sit above a contact section that repeats all
 * three.
 */
import WhatsAppLink from './WhatsAppLink.astro';
import Placeholder from './primitives/Placeholder.astro';
import { CONTACT } from '../config/site';
import { formatPhone, telHref } from '../lib/phone';
import { mailtoHref } from '../lib/enquiry';
import { isPlaceholder } from '../lib/placeholders';

interface Props {
	context?: string;
	label?: string;
	variant?: 'primary' | 'ghost';
	/** Centre the stack, for the hero. */
	align?: 'start' | 'centre';
}

const { context, label, variant = 'primary', align = 'start' } = Astro.props;

const number = CONTACT.whatsapp;
const emailPending = isPlaceholder(CONTACT.email);
---

<div class:list={['contact-methods', `contact-methods--${align}`]}>
	<WhatsAppLink context={context} label={label} variant={variant} />

	<p class="contact-methods__alt">
		or call <a class="contact-methods__link data" href={telHref(number)}>{formatPhone(number)}</a>
		{
			emailPending ? (
				<>
					{' '}
					— email <Placeholder value={CONTACT.email} />
				</>
			) : (
				<>
					{' '}
					—{' '}
					<a class="contact-methods__link" href={mailtoHref(CONTACT.email, context)}>
						email us
					</a>
				</>
			)
		}
	</p>
</div>

<style>
	.contact-methods {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		align-items: flex-start;
	}

	.contact-methods--centre {
		align-items: center;
		text-align: center;
	}

	.contact-methods__alt {
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	/* Inline links keep a 44px target without stretching the line box. */
	.contact-methods__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--link);
		font-weight: var(--weight-medium);
	}

	.contact-methods__link:hover {
		color: var(--link-hover);
	}
</style>
