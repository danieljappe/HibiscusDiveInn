---
/**
 * The site's primary call to action.
 *
 * Two lines exist: `inn` for rooms and general enquiries, `dive` for courses
 * and dive questions. The `context` prop prefills a subject line so a room
 * card or course entry arrives already identified.
 *
 * Amber is only ever a filled background with abyss text — on the sand
 * homepage, --signal as a text or border colour is 1.3:1. The ghost variant
 * uses the foreground colour instead.
 */
import { whatsappHref } from '../lib/enquiry';
import type { ContactChannel } from '../config/site';

interface Props {
	channel: ContactChannel;
	/** Prefilled subject, e.g. "the Garden Room". */
	context?: string;
	/** Visible label. */
	label?: string;
	variant?: 'primary' | 'ghost';
	class?: string;
}

const {
	channel,
	context,
	label = 'Ask on WhatsApp',
	variant = 'primary',
	class: className,
} = Astro.props;

const href = whatsappHref(channel, context);
/* The context is already in the visible label on cards, so only add it to the
   accessible name when it would otherwise be ambiguous. */
const describedContext =
	context && !label.toLowerCase().includes(context.toLowerCase().slice(0, 12));
---

<a
	class:list={['wa', `wa--${variant}`, className]}
	href={href}
	rel="noopener"
	target="_blank"
	data-channel={channel}
>
	<svg class="wa__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"
		></path>
	</svg>
	<span>{label}</span>
	{describedContext && <span class="visually-hidden">— about {context}</span>}
	<span class="visually-hidden">(opens WhatsApp)</span>
</a>

<style>
	.wa {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6em;
		/* Tap target floor is 44px. */
		min-height: 44px;
		padding: 0.7em 1.3em;
		border-radius: var(--radius-md);
		font-weight: var(--weight-semibold);
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.wa__icon {
		width: 1.25em;
		height: 1.25em;
		flex: none;
	}

	.wa--primary {
		background-color: var(--cta-bg);
		color: var(--cta-fg);
		border: 2px solid transparent;
	}

	.wa--primary:hover {
		background-color: var(--cta-bg-hover);
		color: var(--cta-fg);
	}

	.wa--ghost {
		background-color: transparent;
		color: var(--cta-ghost-fg);
		border: 2px solid var(--cta-ghost-border);
	}

	.wa--ghost:hover {
		background-color: var(--cta-ghost-border);
		color: var(--bg);
	}

	.wa:active {
		transform: translateY(1px);
	}

	@media (prefers-reduced-motion: reduce) {
		.wa:active {
			transform: none;
		}
	}
</style>
