---
/**
 * /diving — submerged. Dark palette throughout, continuing down from the
 * homepage teaser at -12m.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DepthRail from '../components/DepthRail.astro';

import Intro from '../components/sections/diving/Intro.astro';
import DiveSites from '../components/sections/diving/DiveSites.astro';
import Courses from '../components/sections/diving/Courses.astro';
import Equipment from '../components/sections/diving/Equipment.astro';
import Instructor from '../components/sections/diving/Instructor.astro';
import DiveContact from '../components/sections/diving/DiveContact.astro';

import { SITE } from '../config/site';
import { DIVING_INTRO_DEPTH, DIVING_TAIL_DEPTHS, railDepthsForSites } from '../config/depths';
import { divingSchema, websiteSchema } from '../lib/schema';
import { isPlaceholder } from '../lib/placeholders';

const description =
	`Diving on ${SITE.place.island}, ${SITE.place.province}. A house reef you can walk into, ` +
	`small groups, and courses with a single instructor.`;
const ogImage = '/og-diving.png';

const sites = (await getCollection('diveSites', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);

const courses = (await getCollection('courses', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order)
	.map(({ data }) => ({ title: data.title, suitableFor: data.suitableFor }));

/*
 * The rail continues from -12m through the dive sites. Sites are spaced evenly
 * until every one has a real depthMaxM, at which point it sorts by measured
 * depth instead.
 */
const siteTicks = railDepthsForSites(
	sites.map((site) => ({
		id: `dive-site-${site.id}`,
		label: isPlaceholder(site.data.title) ? 'Dive site' : site.data.title,
		depthMaxM: site.data.depthMaxM,
	})),
);

const ticks = [DIVING_INTRO_DEPTH, ...siteTicks, ...DIVING_TAIL_DEPTHS];

const jsonLd = [websiteSchema(Astro.site), divingSchema({ site: Astro.site, ogImage, courses })];
---

<BaseLayout title="Diving" description={description} theme="deep" ogImage={ogImage} jsonLd={jsonLd}>
	<DepthRail slot="rail" ticks={ticks} />
	<Header slot="header" current="diving" />

	<Intro />
	<DiveSites />
	<Courses />
	<Equipment />
	<Instructor />
	<DiveContact />

	<Footer slot="footer" theme="deep" />
</BaseLayout>
