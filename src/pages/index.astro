---
/**
 * The homepage. It sits at the surface and has no depth rail — the rail
 * belongs to /diving, where the descent actually happens.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/home/Hero.astro';
import About from '../components/sections/home/About.astro';
import Rooms from '../components/sections/home/Rooms.astro';
import DivingTeaser from '../components/sections/home/DivingTeaser.astro';
import GettingHere from '../components/sections/home/GettingHere.astro';
import Contact from '../components/sections/home/Contact.astro';

import { SITE } from '../config/site';
import { lodgingBusinessSchema, websiteSchema } from '../lib/schema';

const description = `${SITE.description} Enquiries by WhatsApp.`;
const ogImage = '/og-default.png';

const rooms = (await getCollection('rooms', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order)
	.map(({ data }) => ({ title: data.title, sleeps: data.sleeps }));

const jsonLd = [
	websiteSchema(Astro.site),
	lodgingBusinessSchema({ site: Astro.site, ogImage, rooms }),
];
---

<BaseLayout
	title={SITE.name}
	description={description}
	theme="surface"
	ogImage={ogImage}
	jsonLd={jsonLd}
>
	<Header slot="header" current="home" />

	<Hero />
	<About />
	<Rooms />
	<DivingTeaser />
	<GettingHere />
	<Contact />

	<Footer slot="footer" theme="deep" />
</BaseLayout>
