{
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": ["*.md", "*.json", "*.yml", "*.yaml"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
